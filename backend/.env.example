# Location Service Configuration

# Location polling interval in milliseconds (default: 10000 = 10 seconds)
LOCATION_POLLING_INTERVAL=10000

# Client request timeout in milliseconds (default: 5000 = 5 seconds)
CLIENT_REQUEST_TIMEOUT=5000

# Maximum retries before stopping a session (default: 3)
MAX_LOCATION_RETRIES=3

# Mspace API Configuration
MSPACE_API_ENDPOINT=https://api.mspace.lk/location
MSPACE_API_KEY=your_mspace_api_key_here

# Database Configuration
FIREBASE_PROJECT_ID=safestep-d8237
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
